---
import Container from "../components/Container.astro";
import Content from "../components/Content.astro";
import Button from "../components/Button.astro";
---

<Container containerClass="container--column">
  <Content>
    <h2 class="h2 animate--fade-up">STATE OF THE OPEN HOME 2026</h2>
    <div class="content-container text-center">
      <p class="p--large animate--fade-up">
        It was an event to remember! Relive it all (or catch what you missed)
        with the full video below.
      </p>
    </div>
    <div class="buttons-container animate--fade-up">
      <Button
        href="https://www.youtube.com/watch?v=XyAL1to3Lm4"
        target="_blank"
        class="button button--primary"
        icon="youtube"
        starburst={true}
      >
        Rewatch 2026
      </Button>
    </div>
  </Content>
</Container>
