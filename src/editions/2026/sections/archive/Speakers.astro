---
import Container from "../../components/Container.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CircleButton from "../../components/CircleButton.astro";
import SpeakerCard from "../../components/SpeakerCard.astro";
import PhotoSpeakerCard from "../../components/PhotoSpeakerCard.astro";
import GoTo from "../../assets/icons/go-to.svg";
import type { ArchiveEdition } from "../../data/archive";

interface Props {
  edition: ArchiveEdition;
}
const { edition } = Astro.props;
const { intro, cards = [], photos = [] } = edition.speakers;

// One list of slides: illustrated cards, picture-only cards, or placeholders.
const PLACEHOLDER_COUNT = 6;
type Slide =
  | { kind: "card"; props: (typeof cards)[number] }
  | { kind: "photo"; props: (typeof photos)[number] }
  | { kind: "placeholder" };
const slides: Slide[] = cards.length
  ? cards.map((props) => ({ kind: "card", props }))
  : photos.length
    ? photos.map((props) => ({ kind: "photo", props }))
    : Array.from({ length: PLACEHOLDER_COUNT }, () => ({ kind: "placeholder" }));

if (!cards.length && !photos.length) {
  console.warn(`[Speakers] TODO: no speaker cards for ${edition.year} yet (showing placeholders)`);
}
---

<div
  class="speakers"
  data-speakers
  aria-roledescription="carousel"
  aria-labelledby="speakers-title"
>
  <Container containerClass="container--column">
    <SectionHeader
      id="speakers-title"
      title="Meet our speakers"
      intro={intro}
    >
      <div class="speakers__controls">
        <CircleButton
          class="speakers__button speakers__button--prev"
          aria-label="Previous speaker"
          disabled
        >
          <GoTo aria-hidden="true" />
        </CircleButton>
        <CircleButton class="speakers__button" aria-label="Next speaker">
          <GoTo aria-hidden="true" />
        </CircleButton>
      </div>
    </SectionHeader>
  </Container>

  <div class="speakers__track" tabindex="0" role="group" aria-label="Speakers">
    {
      slides.map((slide, i) => (
        <div
          class="speakers__slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
        >
          {slide.kind === "card" ? (
            <SpeakerCard {...slide.props} />
          ) : slide.kind === "photo" ? (
            <PhotoSpeakerCard {...slide.props} />
          ) : (
            <PhotoSpeakerCard />
          )}
        </div>
      ))
    }
  </div>

  <p class="visually-hidden" role="status" aria-live="polite"></p>
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-speakers]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".speakers__track")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const status = root.querySelector<HTMLElement>('[role="status"]')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>(
      ".speakers__button",
    );

    let pending: number | null = null;
    let settled = 0;

    // scrollLeft at which each slide sits on the snap edge. The first slide is
    // snapped at scrollLeft 0, so this is just its distance from that slide.
    // (Don't read scroll-padding from getComputedStyle: it contains a
    // percentage, so it comes back unresolved and parses to NaN.)
    const positionOf = (slide: HTMLElement) =>
      slide.offsetLeft - slides[0].offsetLeft;
    const maxScroll = () => track.scrollWidth - track.clientWidth;
    // Where the track actually stops for a slide: slides near the end can't
    // reach the snap edge, so they all share the final scroll position.
    const stopOf = (slide: HTMLElement) =>
      Math.min(positionOf(slide), maxScroll());

    // Ties go to the earliest slide, so at the end this is lastReachable().
    const nearest = () =>
      slides.reduce(
        (best, slide, i) =>
          Math.abs(stopOf(slide) - track.scrollLeft) <
          Math.abs(stopOf(slides[best]) - track.scrollLeft)
            ? i
            : best,
        0,
      );

    // The last few slides can't reach the snap edge (the track runs out), so
    // stop at the first slide whose position is at or past the end.
    const lastReachable = () => {
      const i = slides.findIndex((slide) => positionOf(slide) >= maxScroll());
      return i === -1 ? slides.length - 1 : i;
    };

    const go = (direction: number) => {
      const target = Math.min(
        lastReachable(),
        Math.max(0, (pending ?? nearest()) + direction),
      );
      pending = target;
      track.scrollTo({
        left: stopOf(slides[target]),
        behavior: reducedMotion.matches ? "auto" : "smooth",
      });
    };

    const updateButtons = () => {
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft >= maxScroll() - 1;
      // Move focus off a button before disabling it.
      if (atStart && document.activeElement === prev) next.focus();
      if (atEnd && document.activeElement === next) prev.focus();
      prev.disabled = atStart;
      next.disabled = atEnd;
    };

    const onSettle = () => {
      pending = null;
      updateButtons();
      const current = nearest();
      if (current !== settled) {
        settled = current;
        // Illustrated cards hold the name as text; picture-only cards in alt.
        const slide = slides[current];
        const name =
          slide.querySelector(".speaker-card__name")?.textContent ??
          slide.querySelector("img")?.alt ??
          "";
        const label = name.trim().replace(/\s+/g, " ");
        status.textContent = `Speaker ${current + 1} of ${slides.length}${label ? `: ${label}` : ""}`;
      }
    };

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));

    if ("onscrollend" in window) {
      track.addEventListener("scrollend", onSettle);
    } else {
      let timer: ReturnType<typeof setTimeout>;
      track.addEventListener(
        "scroll",
        () => {
          clearTimeout(timer);
          timer = setTimeout(onSettle, 120);
        },
        { passive: true },
      );
    }

    window.addEventListener("resize", updateButtons, { passive: true });
    updateButtons();
  });
</script>

<style lang="scss">
  @use "../../styles/mixins/breakpoint.scss" as *;

  .speakers__controls {
    display: flex;
    gap: 1rem;
  }

  .speakers__button--prev :global(svg) {
    rotate: 180deg;
  }

  .speakers__track {
    // Align the first card with the 1200px content column, bleed off the right.
    --gutter: max(1.5rem, calc((100% - 1200px) / 2));

    display: flex;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    touch-action: pan-x pan-y;

    &::-webkit-scrollbar {
      display: none;
    }

    &:focus-visible {
      outline: 2px solid var(--ohf-light-grey);
      outline-offset: 4px;
    }
  }

  .speakers__slide {
    flex: 0 0 208px;
    scroll-snap-align: start;

    @include bp(tablet) {
      flex-basis: 291px;
    }
  }
</style>
