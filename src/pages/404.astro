---
import Layout from "@2026/layouts/Layout.astro";
import Header from "@2026/components/Header.astro";
import Container from "@2026/components/Container.astro";
import Button from "@2026/components/Button.astro";
import Footer from "@2026/sections/Footer.astro";
---

<Layout title="Page not found" noindex>
  <Header slot="header" lightMode />
  <Container containerClass="container--column">
      <div class="not-found">
        <h1 class="h1">Error 404</h1>
        <p>
          Sorry, the page you were looking for was not found. Use the website
          navigation to get back on track.
        </p>
        <Button href="/" class="button button--primary">Back to home</Button>
      </div>
  </Container>
  <Footer slot="footer" />
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    plausible("404");
  });
</script>

<style lang="scss">
  .not-found {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;

    h1,
    p {
      color: var(--text-on-light);
    }

    p {
      max-width: 600px;
    }
  }
</style>
