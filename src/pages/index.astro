---
import Layout from "@2026/layouts/Layout.astro";
import Header from "@2026/components/Header.astro";
import Intro from "@2026/sections/Intro.astro";
import WhatIs from "@2026/sections/WhatIs.astro";
import Carousel from "@2026/components/Carousel.astro";
import Building from "@2026/sections/Building.astro";
import ConversationContinues from "@2026/sections/ConversationContinues.astro";
import Footer from "@2026/sections/Footer.astro";
import Hero from "@2026/sections/Hero.astro";
---

<Layout theme="gradient">
  <Header slot="header" />
  <section class="block block-hero">
    <Hero />
  </section>
  <section class="block block-sotoh">
    <Intro />
  </section>
  <section class="block block-image-carousel">
    <Carousel />
  </section>
  <section class="block block-what-is" id="what-is-state-of-the-open-home">
    <WhatIs />
  </section>
  <section class="block block-building" id="building-in-the-open">
    <Building />
  </section>
  <section
    class="block block-conversation-continues"
    id="the-conversation-continues"
  >
    <ConversationContinues />
  </section>
  <Footer slot="footer" />
</Layout>

<style lang="scss">
  @use "../editions/2026/styles/mixins/breakpoint.scss" as *;

  .block {
    &-sotoh,
    &-what-is {
      padding: 2.5rem 0;

      @include bp(tablet) {
        padding: 5rem 0;
      }
    }

    &-building {
      padding: 0 0 2.5rem;

      @include bp(tablet) {
        padding: 0 0 5rem;
      }
    }
  }
</style>
