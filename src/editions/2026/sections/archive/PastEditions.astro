---
import { Image } from "astro:assets";
import Container from "../../components/Container.astro";
import LinkCard from "../../components/LinkCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Divider from "../../assets/icons/divider.svg";
import { pastEditions, pastEditionLinks } from "../../data/archive-links";
---

<Container containerClass="container--column">
  <SectionHeader title="Feel the vibe by visiting our event archive!" />
</Container>

<div class="past-editions">
  {
    pastEditions.map((edition, i) => (
      <>
        {i > 0 && (
          <div class="past-editions__divider" aria-hidden="true">
            <Divider />
          </div>
        )}
        <Container containerClass="container--column">
          <article
            class:list={["edition", { "edition--flipped": i % 2 === 1 }]}
            aria-labelledby={`edition-${edition.year}`}
          >
            <h3 class="edition__year" id={`edition-${edition.year}`}>
              {edition.year}
            </h3>
            <Image
              class="edition__image"
              src={edition.image}
              alt={edition.imageAlt}
              widths={[400, 560, 800, 1100]}
              sizes="(min-width: 1024px) 376px, 100vw"
            />
            <ul class="edition__links" role="list">
              {pastEditionLinks(edition).map((link) => (
                <li>
                  <LinkCard {...link} class="edition__link" />
                </li>
              ))}
            </ul>
          </article>
        </Container>
      </>
    ))
  }
</div>

<style lang="scss">
  @use "../../styles/mixins/breakpoint.scss" as *;
  @use "../../styles/mixins/card" as *;

  .past-editions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  // The Figma divider is drawn at 1440px with sparkles aligned to the grid,
  // so it is shown at its native size, centred, rather than stretched.
  .past-editions__divider {
    display: none;
    overflow: hidden;

    @include bp(desktop) {
      display: flex;
      justify-content: center;
    }

    :global(svg) {
      flex-shrink: 0;
    }
  }

  .edition {
    width: 100%;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;

    @include bp(desktop) {
      min-height: 240px;
      grid-template-columns: fit-content(100%) repeat(4, minmax(0, 1fr));
      grid-template-rows: auto;
    }
  }

  .edition__year {
    @include glass-card;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    font-family: var(--typography-heading-font-family);
    font-size: 1rem;
    line-height: 1;

    @include bp(desktop) {
      grid-column: 1;
    }
  }

  .edition__image {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-s);

    @include bp(desktop) {
      // Fill the row without letting the photo's own ratio set its height.
      aspect-ratio: auto;
      height: 0;
      min-height: 100%;
      grid-column: 2 / span 2;
      grid-row: 1;
    }
  }

  .edition__links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    @include bp(desktop) {
      grid-column: 4 / span 2;
      grid-row: 1;

      > li {
        flex: 1;
        display: flex;
      }
    }
  }

  .edition--flipped {
    @include bp(desktop) {
      .edition__image {
        grid-column: 4 / span 2;
      }

      .edition__links {
        grid-column: 2 / span 2;
      }
    }
  }

  // Cards in this section are title-only and stretch to fill the row height.
  .edition :global(.edition__link) {
    flex: 1;
    padding-block: 1rem;

    @include bp(desktop) {
      padding-block: 0.5rem;
    }
  }
</style>
