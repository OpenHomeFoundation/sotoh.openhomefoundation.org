---
import FullImage from "../components/FullImage.astro";

import bePartImg from "../images/the-conversation-continues.webp";
---

<FullImage image={bePartImg}>
  <h2 class="h2 be-part--title">The conversation continues</h2>
  <div class="be-part--content-container content-container">
    <p class="be-part--content animate--fade-up">
      State of the Open Home will return in 2027, and we’re planning to make it
      bigger and better than ever – and you can help by <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSeuqPALL5ilFLm_w1PTc3_m-fnMIG7TMI4DldpCtA2bQtCapA/viewform?usp=send_form"
        target="_blank"
        rel="noreferrer noopener">sharing your thoughts on 2026</a
      > and what you’d like to see next year.
    </p>
    <p class="be-part--content animate--fade-up">
      In the meantime, stay connected with the community: <a
        href="https://luma.com/homeassistant"
        target="_blank"
        rel="noreferrer noopener">join meetups worldwide</a
      >, participate in forums, and follow us for updates on <strong
        >State of the Open Home 2027</strong
      >.
    </p>
  </div>
</FullImage>

<style lang="scss">
  @use "../styles/mixins/breakpoint.scss" as *;

  .limited-tickets {
    text-decoration: none;
    background-image: linear-gradient(
      transparent calc(100% - 1px),
      var(--text-on-dark) 1px
    );
    background-size: 100% 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s;

    &:hover {
      background-size: 0% 100%;
    }
  }

  .be-part--content-container {
    width: 100%;
  }

  .be-part--title {
    @include bp(tablet) {
      width: 40%;
      flex-shrink: 0;
    }
  }

  .be-part--content {
    text-wrap: auto;
  }
</style>
