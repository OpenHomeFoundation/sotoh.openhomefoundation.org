---
import Container from "../components/Container.astro";
import Content from "../components/Content.astro";

import { ICONS } from "../lib/icons";

import BrandIcon from "./BrandIcon.astro";

const YT_VIDEO_ID = "TTsSRewv9ag";
const YT_EMBED_SRC = `https://www.youtube.com/embed/${YT_VIDEO_ID}?autoplay=1&mute=1&controls=1&loop=1&playlist=${YT_VIDEO_ID}&rel=0&enablejsapi=1`;

import videoPlaceholderImg from "../images/sotoh-highlights-placeholder.webp";
---

<Container containerClass="container--hero">
  <div class="brand-icons">
    <BrandIcon icon="building" />
    <BrandIcon icon="privacy" />
    <BrandIcon icon="choice" />
    <BrandIcon icon="sustainability" />
  </div>

  <Content>
    <div class="hero__content">
      <p class="event-host p--large">
        An event organized by the <Fragment set:html={ICONS["OHFLogo"]} />
      </p>
      <h1 class="h1">STATE OF THE OPEN HOME</h1>
      <p class="hero__description p--large">
        Our annual event championing privacy, choice, and sustainability in the
        Open Home.
      </p>
    </div>
  </Content>
</Container>

<div class="recap-container">
  <div
    class="video-container"
    style={`--placeholder: url(${videoPlaceholderImg.src})`}
  >
    <iframe
      data-src={YT_EMBED_SRC}
      width="1080"
      height="608"
      title="State of the Open Home 2026 Highlights"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
</div>

<style lang="scss">
  @use "../styles/mixins/breakpoint.scss" as *;

  @keyframes animate-up-fade {
    0% {
      transform: translate3d(0, 50%, 0);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  img {
    width: 100%;
    height: auto;
  }

  :global(.button) {
    position: relative;
    overflow: visible;

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.5s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.75s;
    }
  }

  h1 {
    margin-bottom: 0;
    text-align: center;

    @include bp(desktop) {
      text-align: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.5s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.65s;
    }
  }

  p.event-host {
    line-height: 1.4;
    margin-bottom: 0;

    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0 0.6rem;
    flex-wrap: wrap;

    @include bp(desktop) {
      justify-content: flex-start;
    }

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.45s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.55s;
    }

    :global(svg) {
      width: 100%;
      max-width: 350px;
      max-height: 34px;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero__description {
    text-align: center;
    text-wrap: auto;
    margin-top: 0.5rem;

    @include bp(desktop) {
      text-align: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.45s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.65s;
    }
  }

  .recap-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;

    @include bp(desktop) {
      margin-top: 2.5rem;
    }
  }

  .video-container {
    position: relative;
    width: 100%;
    background-image: var(--placeholder);
    background-size: cover;
    background-position: center;

    iframe {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  .brand-icons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, auto);

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.85s;
      animation-timing-function: var(--entry-ease);
    }
  }
</style>

<script>
  const container = document.querySelector(".video-container");
  const iframe = document.querySelector(".video-container iframe");

  if (container && iframe) {
    let player = null;
    let loaded = false;

    const loadVideo = () => {
      if (loaded) return;
      loaded = true;
      iframe.src = iframe.dataset.src;

      const tag = document.createElement("script");
      tag.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(tag);

      window.onYouTubeIframeAPIReady = () => {
        player = new window.YT.Player(iframe, {
          events: {
            onStateChange: ({ data }) => {
              // 0 = ended — loop back as background
              if (data === 0) {
                player.seekTo(0);
                player.playVideo();
              }
            },
          },
        });
      };
    };

    // Load on first user intent
    document.addEventListener("mousemove", loadVideo, { once: true });
    document.addEventListener("touchstart", loadVideo, { once: true });

    // Pause/play background loop when scrolled out of view
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          player?.playVideo();
        } else {
          player?.pauseVideo();
        }
      },
      { threshold: 0 },
    ).observe(container);
  }
</script>
