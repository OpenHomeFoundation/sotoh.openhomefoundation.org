---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Intro from "../sections/Intro.astro";
import WhatIs from "../sections/WhatIs.astro";
import Carousel from "../components/Carousel.astro";
import Building from "../sections/Building.astro";
import ConversationContinues from "../sections/ConversationContinues.astro";
import Footer from "../sections/Footer.astro";
import Hero from "../components/Hero.astro";
---

<Layout bodyClass="page-home">
  <Header slot="header" />
  <section class="block block-hero">
    <Hero />
  </section>
  <section class="block block-sotoh">
    <Intro />
  </section>
  <section class="block block-image-carousel">
    <Carousel />
  </section>
  <section class="block block-what-is" id="what-is-state-of-the-open-home">
    <WhatIs />
  </section>
  <section class="block block-building" id="building-in-the-open">
    <Building />
  </section>
  <section
    class="block block-conversation-continues"
    id="the-conversation-continues"
  >
    <ConversationContinues />
  </section>
  <Footer slot="footer" />
</Layout>

<style lang="scss">
  @use "../styles/mixins/breakpoint.scss" as *;

  .block {
    &-sotoh,
    &-what-is {
      padding: 2.5rem 1rem;

      @include bp(tablet) {
        padding: 5rem 1rem;
      }
    }

    &-building {
      padding: 0 1rem 2.5rem;

      @include bp(tablet) {
        padding: 0 1rem 5rem;
      }
    }
  }
</style>
