---
import { ICONS, type ICON } from "../lib/icons";

interface Props {
  class?: string;
  href?: string;
  icon?: ICON;
  disabled?: boolean;
  target?: string;
  starburst?: boolean;
  rel?: string;
}
const {
  class: className = "",
  href = "/error",
  icon,
  disabled = false,
  target = "_self",
  starburst = false,
  rel = "",
} = Astro.props;

// Hover "starburst" particles: [icon, angle, size, delay, distance, start-x, colour]
const BURSTS: [ICON, number, number, number, number, number, string][] = [
  ["building", -50, 13, 0, 48, 5, "yellow"],
  ["privacy", -25, 10, 80, 36, 28, "blue"],
  ["sustainability", 5, 11, 40, 42, 47, "purple"],
  ["choice", 30, 9, 140, 37, 68, "yellow"],
  ["building", 55, 12, 200, 52, 88, "blue"],
  ["privacy", 125, 10, 100, 50, 82, "purple"],
  ["choice", 160, 8, 160, 40, 38, "yellow"],
  ["sustainability", -135, 11, 60, 44, 12, "blue"],
];
---

<a
  class={className}
  href={href}
  aria-disabled={disabled}
  target={target}
  rel={rel}
>
  {
    icon ? (
      <div class="button-icon">
        <Fragment set:html={ICONS[icon]} />
      </div>
    ) : null
  }
  <span class="button-text">
    <span class="button-text__default"><slot /></span>
    <span class="button-text__hover" aria-hidden="true"><slot /></span>
  </span>
  {
    starburst &&
      BURSTS.map(([burstIcon, angle, size, delay, distance, startX, color]) => (
        <span
          class="burst"
          style={`--angle: ${angle}deg; --size: ${size}px; --delay: ${delay}ms; --distance: ${distance}px; --start-x: ${startX}%; --color: var(--sotoh-${color});`}
          aria-hidden="true"
        >
          <Fragment set:html={ICONS[burstIcon]} />
        </span>
      ))
  }
</a>

<style lang="scss" is:global>
  @use "../styles/mixins/breakpoint.scss" as *;

  .button {
    position: relative;
    overflow: visible;
    color: var(--text-on-dark);
    padding: 8px 10px;
    border-radius: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: var(--typography-heading-font-family);
    font-weight: var(--typography-heading-font-weight);
    font-size: 0.75rem;
    gap: 12px;
    text-transform: uppercase;

    @include bp(large-mobile) {
      padding: 12px 24px;
    }

    &[aria-disabled="true"] {
      pointer-events: none;
    }

    &:has(.button-icon) {
      padding: 0.5rem 1.5rem 0.5rem 0.5rem;
    }

    &-icon {
      display: grid;
      place-items: center;
      background-color: white;
      height: 24px;
      width: 24px;
      border-radius: 50%;
    }

    &--hollow {
      transition:
        background-color 0.3s ease-in-out,
        color 0.3s ease-in-out,
        border-color 0.3s ease-in-out;
      border: 2px solid var(--sotoh-yellow);

      &.button--secondary {
        border: 2px solid var(--ohf-dark-blue);
        color: var(--ohf-dark-blue);
      }
    }

    &-text {
      display: block;
      position: relative;
      overflow: hidden;

      &__default,
      &__hover {
        display: block;
        transition: transform 0.3s ease-in-out;
      }

      &__default {
        transition: transform 0.3s ease-in-out;
      }

      &__hover {
        position: absolute;
        top: 0;
        left: 0;
        transform: translateY(100%);
      }

      @media (prefers-reduced-motion: reduce) {
        &__hover {
          display: none;
        }

        &__default,
        &__hover {
          transition: none;
        }
      }
    }

    &:hover &-text {
      &__default {
        transform: translateY(-100%);
      }

      &__hover {
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        &__default {
          transform: none;
        }
      }
    }

    &--primary {
      background-color: var(--sotoh-yellow);
      color: var(--ohf-dark-blue);
      transition: background-color 0.3s ease-in-out;
      will-change: background-color;

      .button-text__hover {
        color: var(--sotoh-yellow);
      }

      &:hover {
        background-color: var(--ohf-dark-blue);

        @media (prefers-reduced-motion: reduce) {
          .button-text__default {
            color: var(--sotoh-yellow);
          }
        }
      }

      &.button--primary-hover-light {
        .button-text__hover {
          color: var(--text-on-light);
        }

        &:hover {
          background-color: var(--text-on-dark);

          @media (prefers-reduced-motion: reduce) {
            .button-text__default {
              color: var(--text-on-light);
            }
          }
        }
      }
    }

    &--header {
      @media (max-width: 500px) {
        &:has(.button-icon) {
          padding: 8px 10px;
        }

        .button-icon {
          display: none;
        }
      }
    }

    .burst {
      --angle: 0deg;
      --size: 12px;
      --distance: 60px;
      --delay: 0ms;
      --start-x: 50%;
      --color: var(--sotoh-yellow);

      position: absolute;
      top: 50%;
      left: var(--start-x);
      width: var(--size);
      height: var(--size);
      pointer-events: none;
      z-index: -1;

      transform: translate(-50%, -50%) rotate(var(--angle)) translateY(0)
        scale(0);
      opacity: 0;
      transition:
        transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) var(--delay),
        opacity 0.25s ease var(--delay);

      svg {
        display: block;
        width: 100%;
        height: 100%;
        color: var(--color);
      }
    }

    &:hover .burst {
      transform: translate(-50%, -50%) rotate(var(--angle))
        translateY(calc(var(--distance) * -1)) scale(1);
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .burst {
        display: none;
      }
    }
  }
</style>
