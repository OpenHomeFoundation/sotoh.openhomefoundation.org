---
// Import global styles
import "../styles/_variables.scss";
import "../styles/_reset.scss";
import "../styles/_global.scss";
import "../styles/_typography.scss";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** "gradient" = blue→pink page background (light text); "light" = pale blue (dark text). */
  theme?: "gradient" | "light";
}

const defaultTitle = "State of the Open Home - Open Home Foundation";
const defaultDescription =
  "State of the Open Home is the Open Home Foundation's annual event championing privacy, choice, and sustainability in the smart home.";

const {
  title = defaultTitle,
  description = defaultDescription,
  noindex = false,
  theme = "light",
} = Astro.props;

const fullTitle =
  title === defaultTitle ? title : `${title} - Open Home Foundation`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" data-dev={import.meta.env.DEV ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a2744" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Open Home Foundation" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://sotoh.openhomefoundation.org/sotoh-share-image.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="State of the Open Home 2026" />
    <meta
      property="og:site_name"
      content="State of the Open Home - Open Home Foundation"
    />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://sotoh.openhomefoundation.org/sotoh-share-image.jpg"
    />
    <meta name="twitter:image:alt" content="State of the Open Home 2026" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "name": "State of the Open Home",
            "url": "https://sotoh.openhomefoundation.org/"
          },
          {
            "@type": "Organization",
            "name": "Open Home Foundation",
            "url": "https://www.openhomefoundation.org",
            "logo": "https://sotoh.openhomefoundation.org/favicon.svg"
          }
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Special+Gothic+Expanded+One&display=swap"
      rel="stylesheet"
    />

    <script
      is:inline
      defer
      src="https://plausible.openhomefoundation.org/js/pa-XPZYNJXPpCUmId_QP4aUU.js"
    ></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init =
        plausible.init ||
        function (i) {
          plausible.o = i || {};
        };
      plausible.init();
    </script>
  </head>
  <body class={`theme-${theme}`}>
    <slot name="header" />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main>
          <slot />
        </main>
        <slot name="footer" />
      </div>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
  }

  body.menu-open {
    overflow: hidden;
  }

  #smooth-content {
    padding-top: var(--header-height);
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: "(prefers-reduced-motion: reduce)",
      normal: "(prefers-reduced-motion: no-preference)",
    },
    (context) => {
      const { reduceMotion } = context.conditions!;

      if (!reduceMotion) {
        ScrollSmoother.create({
          smooth: 1,
          effects: true,
        });
      }

      if (reduceMotion) {
        gsap.defaults({ duration: 0 });
      }

      // Fade up animation for elements with .animate--fade-up
      if (!reduceMotion) {
        document.querySelectorAll(".animate--fade-up").forEach((el) => {
          gsap.from(el, {
            y: 40,
            opacity: 0,
            duration: 0.8,
            ease: "power3.out",
            scrollTrigger: {
              trigger: el,
              start: "top 95%",
              toggleActions: "play none none none",
            },
          });
        });
      }
    },
  );

  import { initMatter } from "../lib/matter";
  const siteFooter = document.querySelector("#matter-container");
  if (siteFooter) {
    ScrollTrigger.create({
      trigger: siteFooter,
      start: "top bottom",
      once: true,
      onEnter: () => {
        initMatter();
      },
    });
  }

  // Debounced ScrollTrigger refresh on resize
  let resizeTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener(
    "resize",
    () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        ScrollTrigger.refresh();
      }, 200);
    },
    { passive: true },
  );

  // Smooth-scroll any link that points at a section on the current page
  // ("#id", "/#id", "/2026/#id", …), offset for the fixed header.
  const HEADER_OFFSET = 120;
  const normalise = (path: string) => path.replace(/\/$/, "");

  const scrollToSection = (target: Element) => {
    const smoother = ScrollSmoother.get();
    if (smoother) {
      smoother.scrollTo(target, true, `top top+=${HEADER_OFFSET}`);
    } else {
      const top =
        target.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET;
      window.scrollTo({ top, behavior: "smooth" });
    }
  };

  document.addEventListener("click", (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>(
      "a[href*='#']",
    );
    if (!link) return;
    const url = new URL(link.href);
    const samePage =
      url.origin === location.origin &&
      normalise(url.pathname) === normalise(location.pathname);
    const target =
      samePage && url.hash.length > 1
        ? document.getElementById(url.hash.slice(1))
        : null;
    if (!target) return;

    e.preventDefault();

    // Close mobile menu if open
    const menuToggle = document.querySelector<HTMLInputElement>(
      "#site-header-burger-toggle",
    );
    if (menuToggle?.checked) {
      menuToggle.checked = false;
      menuToggle.dispatchEvent(new Event("change"));
    }

    scrollToSection(target);
    history.replaceState(null, "", url.hash);
  });

  // Handle hash in URL on page load (next frame so ScrollSmoother is ready)
  const initialTarget =
    location.hash.length > 1
      ? document.getElementById(location.hash.slice(1))
      : null;
  if (initialTarget) {
    requestAnimationFrame(() => scrollToSection(initialTarget));
  }
</script>
