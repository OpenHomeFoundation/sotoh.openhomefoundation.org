---
import Container from "../components/Container.astro";
import Content from "../components/Content.astro";

import { ICONS } from "../lib/icons";

import BrandIcon from "./BrandIcon.astro";

const YT_VIDEO_ID = "TTsSRewv9ag";
const YT_EMBED_SRC = `https://www.youtube.com/embed/${YT_VIDEO_ID}?autoplay=1&mute=1&controls=0&loop=1&playlist=${YT_VIDEO_ID}&modestbranding=1&iv_load_policy=3&disablekb=1&rel=0&enablejsapi=1`;
---

<Container containerClass="container--hero">
  <div class="brand-icons">
    <BrandIcon icon="building" />
    <BrandIcon icon="privacy" />
    <BrandIcon icon="choice" />
    <BrandIcon icon="sustainability" />
  </div>

  <Content>
    <div class="hero__content">
      <p class="event-host p--large">
        An event organized by the <Fragment set:html={ICONS["OHFLogo"]} />
      </p>
      <h1 class="h1">STATE OF THE OPEN HOME</h1>
      <p class="hero__description p--large">
        Our annual event championing privacy, choice, and sustainability in the
        Open Home.
      </p>
    </div>
  </Content>
</Container>

<div class="recap-container">
  <div class="video-container">
    <iframe
      data-src={YT_EMBED_SRC}
      width="1080"
      height="608"
      title="State of the Open Home 2026 Highlights"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <button
      class="video-link"
      aria-label="Play State of the Open Home 2026 highlights"
    >
      <div class="video-cursor" aria-hidden="true">
        <svg
          class="icon--play"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="5,3 18,10 5,17"></polygon>
        </svg>
        <svg
          class="icon--pause"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="4" y="3" width="4" height="14"></rect>
          <rect x="12" y="3" width="4" height="14"></rect>
        </svg>
      </div>
    </button>
  </div>
</div>

<style lang="scss">
  @use "../styles/mixins/breakpoint.scss" as *;

  @keyframes animate-up-fade {
    0% {
      transform: translate3d(0, 50%, 0);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  img {
    width: 100%;
    height: auto;
  }

  :global(.button) {
    position: relative;
    overflow: visible;

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.5s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.75s;
    }
  }

  h1 {
    margin-bottom: 0;
    text-align: center;

    @include bp(desktop) {
      text-align: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.5s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.65s;
    }
  }

  p.event-host {
    line-height: 1.4;
    margin-bottom: 0;

    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0 0.6rem;
    flex-wrap: wrap;

    @include bp(desktop) {
      justify-content: flex-start;
    }

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.45s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.55s;
    }

    :global(svg) {
      width: 100%;
      max-width: 350px;
      max-height: 34px;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero__description {
    text-align: center;
    text-wrap: auto;
    margin-top: 0.5rem;

    @include bp(desktop) {
      text-align: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.45s;
      animation-timing-function: var(--entry-ease);
      animation-delay: 0.65s;
    }
  }

  .recap-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;

    @include bp(desktop) {
      margin-top: 2.5rem;
    }
  }

  .video-container {
    position: relative;
    width: 100%;

    iframe {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      pointer-events: none;
    }

    .video-link {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;

      @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
        cursor: none;
      }
    }

    .icon--pause {
      display: none;
    }

    &.is-playing .icon--play {
      display: none;
    }

    &.is-playing .icon--pause {
      display: block;
    }

    .video-cursor {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ohf-dark-blue);
      pointer-events: none;

      @include bp(tablet) {
        width: 80px;
        height: 80px;
      }
    }
  }

  .brand-icons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, auto);

    @media (prefers-reduced-motion: no-preference) {
      opacity: 0;
      animation-name: animate-up-fade;
      animation-fill-mode: forwards;
      animation-duration: 0.85s;
      animation-timing-function: var(--entry-ease);
    }
  }
</style>

<script>
  import gsap from "gsap";

  const container = document.querySelector(".video-container");
  const link = document.querySelector(".video-link");
  const cursor = document.querySelector(".video-cursor");
  const iframe = document.querySelector(".video-container iframe");

  if (container && link && cursor && iframe) {
    const hasPointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (hasPointer && !prefersReducedMotion) {
      cursor.style.top = "0";
      cursor.style.left = "0";

      const rect = container.getBoundingClientRect();
      gsap.set(cursor, {
        xPercent: -50,
        yPercent: -50,
        x: rect.width / 2,
        y: rect.height / 2,
        opacity: 0,
      });

      const xTo = gsap.quickTo(cursor, "x", {
        duration: 0.2,
        ease: "power2.out",
      });
      const yTo = gsap.quickTo(cursor, "y", {
        duration: 0.2,
        ease: "power2.out",
      });

      link.addEventListener("mousemove", (e) => {
        const r = container.getBoundingClientRect();
        xTo(e.clientX - r.left);
        yTo(e.clientY - r.top);
      });

      link.addEventListener("mouseleave", () => {
        gsap.to(cursor, { opacity: 0, duration: 0.2 });
      });

      link.addEventListener("mouseenter", () => {
        gsap.to(cursor, { opacity: 1, duration: 0.2 });
      });
    }

    let player = null;
    let loaded = false;
    // 'background' = muted autoplay, 'playing' = unmuted, 'paused' = paused
    let videoState = "background";

    const setPlaying = (playing) => {
      videoState = playing ? "playing" : "paused";
      container.classList.toggle("is-playing", playing);
      link.setAttribute("aria-label", playing ? "Pause video" : "Play video");

      if (!hasPointer) {
        if (playing) {
          // Swap to pause icon then fade out
          gsap.to(cursor, { opacity: 0, duration: 0.3, delay: 0.4 });
        } else {
          // Fade play icon back in
          gsap.to(cursor, { opacity: 1, duration: 0.3 });
        }
      }
    };

    const loadVideo = () => {
      loaded = true;
      iframe.src = iframe.dataset.src;

      const tag = document.createElement("script");
      tag.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(tag);

      window.onYouTubeIframeAPIReady = () => {
        player = new window.YT.Player(iframe, {
          events: {
            onStateChange: ({ data }) => {
              // 0 = ended
              if (data === 0) {
                if (videoState === "playing") {
                  // Return to muted background loop
                  player.mute();
                  player.seekTo(0);
                  player.playVideo();
                  videoState = "background";
                  container.classList.remove("is-playing");
                  if (!hasPointer)
                    gsap.to(cursor, { opacity: 1, duration: 0.3 });
                } else {
                  player.seekTo(0);
                  player.playVideo();
                }
              }
            },
          },
        });
      };
    };

    link.addEventListener("click", () => {
      if (!player) return;
      if (videoState === "background") {
        player.unMute();
        player.seekTo(0);
        player.playVideo();
        setPlaying(true);
      } else if (videoState === "playing") {
        player.pauseVideo();
        setPlaying(false);
      } else {
        player.playVideo();
        setPlaying(true);
      }
    });

    // Load on first user intent
    document.addEventListener("mousemove", loadVideo, { once: true });
    document.addEventListener("touchstart", loadVideo, { once: true });

    // Pause/play background loop when scrolled out of view
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (videoState === "background") player?.playVideo();
        } else {
          if (videoState === "background") player?.pauseVideo();
        }
      },
      { threshold: 0 },
    ).observe(container);
  }
</script>
